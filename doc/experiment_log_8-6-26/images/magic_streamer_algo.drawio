  <diagram name="magic_streamer_algo" id="magicalgo">
    <mxGraphModel dx="4040" dy="2374" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="2140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=left;" value="Magic Streamer Buffer Allocation — _magic_streamer_report()" vertex="1">
          <mxGeometry height="24" width="700" x="300" y="4" as="geometry" />
        </mxCell>
        <mxCell id="start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="START&lt;br&gt;_magic_streamer_report(streams, total_banks, amt_phase)" vertex="1">
          <mxGeometry height="50" width="320" x="360" y="40" as="geometry" />
        </mxCell>
        <mxCell id="p_geom" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" value="Stage 1 — per-stream geometry&lt;br&gt;for each stream compute:&lt;br&gt;• amt_entry_per_query = ∏ shape[:-1]&lt;br&gt;• bits_per_entry = precision × shape[-1]&lt;br&gt;• amt_banks_per_entry = ⌈bits_per_entry ÷ BW⌉&lt;br&gt;• amt_query_per_bankGrp = BD ÷ amt_entry_per_query" vertex="1">
          <mxGeometry height="120" width="440" x="300" y="120" as="geometry" />
        </mxCell>
        <mxCell id="d_fit" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="amt_query_per_bankGrp == 0 ?&lt;br&gt;(one query bigger than a bank group)" vertex="1">
          <mxGeometry height="110" width="260" x="390" y="280" as="geometry" />
        </mxCell>
        <mxCell id="p_phase_init" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="Stage 2 — allocation across phases&lt;br&gt;alloc_phase = 0" vertex="1">
          <mxGeometry height="60" width="300" x="370" y="430" as="geometry" />
        </mxCell>
        <mxCell id="d_phase" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="alloc_phase &lt; amt_phase ?" vertex="1">
          <mxGeometry height="110" width="260" x="390" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p_collect" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="phase_streams =&lt;br&gt;streams with alloc_phase == this phase" vertex="1">
          <mxGeometry height="70" width="340" x="350" y="670" as="geometry" />
        </mxCell>
        <mxCell id="d_stream" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="more streams left&lt;br&gt;in phase_streams ?" vertex="1">
          <mxGeometry height="110" width="260" x="390" y="780" as="geometry" />
        </mxCell>
        <mxCell id="d_reuse" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="free streamer with same&lt;br&gt;amt_banks_per_entry AND region ?" vertex="1">
          <mxGeometry height="120" width="300" x="370" y="930" as="geometry" />
        </mxCell>
        <mxCell id="p_create" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="[create]&lt;br&gt;new streamer (mul_factor = 1)&lt;br&gt;next_fin_phase = free_phase&lt;br&gt;add to using pool" vertex="1">
          <mxGeometry height="80" width="340" x="350" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="p_reuse" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="[reuse]&lt;br&gt;assign stream to free streamer&lt;br&gt;next_fin_phase = free_phase&lt;br&gt;move free → using" vertex="1">
          <mxGeometry height="90" width="260" x="770" y="940" as="geometry" />
        </mxCell>
        <mxCell id="p_free" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="free using streamers whose&lt;br&gt;next_fin_phase == alloc_phase&lt;br&gt;(move using → free)" vertex="1">
          <mxGeometry height="80" width="340" x="350" y="1210" as="geometry" />
        </mxCell>
        <mxCell id="p_inc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="alloc_phase += 1" vertex="1">
          <mxGeometry height="60" width="300" x="370" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="d_empty" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="dfx_streamers empty ?" vertex="1">
          <mxGeometry height="110" width="260" x="390" y="1430" as="geometry" />
        </mxCell>
        <mxCell id="p_upgrade" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Stage 3 — upgrade loop&lt;br&gt;total_banks_used = Σ banks_per_entry × mul_factor&lt;br&gt;bottleneck = streamer with smallest&lt;br&gt;mul_factor × min(amt_query_per_bankGrp)" vertex="1">
          <mxGeometry height="120" width="440" x="300" y="1580" as="geometry" />
        </mxCell>
        <mxCell id="d_budget" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="total_banks_used + bottleneck.banks_per_entry&lt;br&gt;&gt; total_banks ?" vertex="1">
          <mxGeometry height="130" width="280" x="380" y="1740" as="geometry" />
        </mxCell>
        <mxCell id="p_report" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="Stage 4 — report&lt;br&gt;min_total_query =&lt;br&gt;min(mul_factor × amt_query_per_bankGrp)" vertex="1">
          <mxGeometry height="80" width="380" x="330" y="1910" as="geometry" />
        </mxCell>
        <mxCell id="end" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="RETURN&lt;br&gt;{dfx_streamers, total_banks_used, min_total_query}" vertex="1">
